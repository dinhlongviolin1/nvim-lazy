// Global markdownlint-cli2 config — applies everywhere via nvim-lint's
// explicit --config flag (markdownlint-cli2 doesn't check $HOME on its own,
// only walks up from the file's own directory for a project-level config).
{
  "config": {
    // Line-length: fires on any prose line over 80 chars. Constant noise for
    // normal writing, not something a project-level config should have to
    // opt out of individually every time.
    "MD013": false
  }
}
